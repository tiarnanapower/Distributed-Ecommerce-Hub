# ---------------------------------------------------------------------------
# Commerce Command Center — environment variables
# Copy to `.env` (`npm run db:setup` does this for you and generates secrets).
# See docs/environment-variables.md for the full reference.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# SQLite for local development. To move to PostgreSQL, change the Prisma
# datasource provider in prisma/schema.prisma and point this at your instance.
DATABASE_URL="file:./dev.db"

# --- Application -----------------------------------------------------------
NODE_ENV="development"
APP_BASE_URL="http://localhost:3000"

# --- Security --------------------------------------------------------------
# 32-byte base64 key used to encrypt stored BigCommerce credentials (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PRODUCTION: use a managed KMS / secret manager instead. See docs/security.md.
ENCRYPTION_KEY=""

# 32+ byte secret used to sign local session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=""

# Session lifetime in hours.
SESSION_TTL_HOURS="12"

# --- Operating mode --------------------------------------------------------
# "demo"      — seeded data only; no outbound BigCommerce calls are ever made.
# "connected" — stores with saved credentials use the live BigCommerce API.
# "hybrid"    — per-connection: demo connections use seed data, real ones call out.
COMMERCE_MODE="hybrid"

# Hard kill-switch. When "true" the BigCommerce provider refuses every request,
# including reads. Useful for demos on untrusted networks.
DISABLE_OUTBOUND_API="false"

# --- BigCommerce API defaults ----------------------------------------------
BIGCOMMERCE_API_HOST="https://api.bigcommerce.com"
BIGCOMMERCE_LOGIN_HOST="https://login.bigcommerce.com"
BIGCOMMERCE_REQUEST_TIMEOUT_MS="20000"
BIGCOMMERCE_MAX_RETRIES="3"

# Optional: a single default store used by `npm run bc:probe`. Leave blank to
# rely purely on connections configured in the UI.
BIGCOMMERCE_STORE_HASH=""
BIGCOMMERCE_ACCESS_TOKEN=""

# --- Jobs ------------------------------------------------------------------
# The local job runner is in-process and persisted to the database.
JOB_RUNNER_ENABLED="true"
JOB_RUNNER_POLL_MS="2000"
JOB_RUNNER_BATCH_SIZE="25"

# --- Logging ---------------------------------------------------------------
LOG_LEVEL="info"
